# Contact form mailer (Gmail SMTP).
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Gmail account that sends the mail.
GMAIL_USER=sohamrc08@gmail.com

# 16-character Google App Password (Google Account > Security > 2-Step Verification > App passwords).
# Not your normal Gmail password.
GMAIL_APP_PASSWORD=

# Inbox that receives contact form messages. Defaults to sohamrc08@gmail.com.
CONTACT_TO=sohamrc08@gmail.com
